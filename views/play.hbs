<!DOCTYPE html>
<html lang='es'>
    <head>

        <meta charset='UTF-8'>
        <link rel='stylesheet' href='/style.css'>
        <link rel='icon' href='/img/wctrophy.png' type='image/png'>
        <meta name='viewport' content='width=device-width, initial-scale=1.0' >
        <link rel="manifest" href="/manifest.json">

        <title>Mundial 2026</title>
    </head>
    <body>
        <nav class="nav-bar">
            <a href="/">
            <img src='/img/wctrophy.png' height="50px" style="margin-left: 15px;">
            </a>
            <ul class="menu-links">
                <li><a href="/">Inicio</a></li>
                <li><a href="/teams">Equipos</a></li>
                <li><a href="/profile" style="margin:0;">{{username}}</a></li>
                <li><a href="/auth/logout">Cerrar sesión</a></li>
                <li><a href="/play">Jugar</a>
                <li><a href="/leaderboard">Tabla</a></li>
            </ul>
        </nav>
        <div class="mobile-nav-bar">
            <a href="/"><img id="home" src="/img/icons/home.png" alt="home"><label>Inicio</label></a>
            <a href="/play"><img src="/img/icons/play_active.png" alt="play"><label class="menu-active">Jugar</label></a>
            <a href="/leaderboard"><img src="/img/icons/leaderboard.png" alt="leaderboard"><label>Tabla</label></a>
            <a href="/teams"><img src="/img/icons/teams.png" alt="teams"><label>Equipos</label></a>
            <a href="/profile"><img src="/img/icons/perfil.png" alt="perfil"><label>Perfil</label></a>
        </div>
        <div class="container bold">
        <div id="jugadores">
                {{#if players_selected}}
            <div id="partidos">
                <h2>Partidos</h2>
                <div class="colores-indicadores">
                    <div class="verde"></div>
                    <div class="azul"></div>
                    <div class="gris"></div>
                    <div class="texto-pequeno">Abierto</div>
                    <div class="texto-pequeno">Enviado</div>
                    <div class="texto-pequeno">Cerrado</div>
                </div>
                {{#if FDG_SENT}}
                    <a href="/misQuinielas/FDG" class="azul enviado">Fase de Grupos</a>
                {{else if FDG }}
                    <a class="verde" href="/play/FDG">Fase de Grupos</a>
                {{else}}
                    <div class="gris cerrado">Fase de Grupos</div>
                {{/if}}

                {{#if R32_SENT}}
                    <a href="/misQuinielas/16VOS" class="azul enviado">Dieciseisavos</a>
                {{else if R32 }}
                    <a class="verde" href="/play/16VOS">Dieciseisavos</a>
                {{else}}
                    <div class="gris cerrado">Dieciseisavos</div>
                {{/if}}

                {{#if R16_SENT}}
                    <a href="/misQuinielas/OCTAVOS" class="azul enviado">Octavos</a>
                {{else if R16 }}
                    <a class="verde" href="/play/OCTAVOS">Octavos</a>
                {{else}}
                    <div class="gris cerrado">Octavos</div>
                {{/if}}

                {{#if R8_SENT}}
                    <a href="/misQuinielas/CUARTOS" class="azul enviado">Cuartos</a>
                {{else if R8 }}
                    <a class="verde" href="/play/CUARTOS">Cuartos</a>
                {{else}}
                    <div class="gris cerrado">Cuartos</div>
                {{/if}}

                {{#if SF_SENT}}
                    <a href="/misQuinielas/SEMIS" class="azul enviado">Semifinales</a>
                {{else if SF }}
                    <a class="verde" href="/play/SEMIS">Semifinales</a>
                {{else}}
                    <div class="gris cerrado">Semifinales</div>
                {{/if}}

                {{#if TP_SENT}}
                    <a href="/misQuinielas/TERCER_PUESTO" class="azul enviado">Tercer Puesto</a>
                {{else if TP }}
                    <a class="verde" href="/play/TERCER_PUESTO">Tercer Puesto</a>
                {{else}}
                    <div class="gris cerrado">Tercer Puesto</div>
                {{/if}}

                {{#if F_SENT}}
                    <a href="/misQuinielas/FINAL" class="azul enviado">Final</a>
                {{else if F }}
                    <a class="verde" href="/play/FINAL">Final</a>
                {{else}}
                    <div class="gris cerrado">Final</div>
                {{/if}}

            </div>
            {{else}} 
                <h2>Elige a tus Jugadores</h2>
                <form id="seleccionar_jugadores" action="/load_max_goleador" method="POST">
                    <div>Selecciona al Máximo Goleador</div>
                    <div>Selecciona al Máximo Asistidor</div>
                    <div class="player-selector">
                        <input type="text"
                            class="buscar-jugador"
                            placeholder="Buscar máximo goleador..."
                            autocomplete="off">

                        <input type="hidden"
                            name="maximo_goleador"
                            class="player-id"
                            required>

                        <div class="resultados">
                            {{#each players}}
                                <div class="jugador" data-id="{{id}}">
                                    {{name}} ({{short_name}})
                                </div>
                            {{/each}}
                        </div>
                    </div>
                    
                   
                   <div class="player-selector">
                        <input type="text"
                            class="buscar-jugador"
                            placeholder="Buscar máximo asistidor..."
                            autocomplete="off">

                        <input type="hidden"
                            name="maximo_asistidor"
                            class="player-id"
                            required>

                        <div class="resultados">
                            {{#each players}}
                                <div class="jugador" data-id="{{id}}">
                                    {{name}} ({{short_name}})
                                </div>
                            {{/each}}
                        </div>
                    </div>



                    <div style="height: 20px;"></div><div></div>
                    <div>Selecciona al Mejor Jugador</div>
                    <div>Selecciona al Mejor Portero</div>

                    <div class="player-selector">
                        <input type="text"
                            class="buscar-jugador"
                            placeholder="Buscar mejor jugador..."
                            autocomplete="off">

                        <input type="hidden"
                            name="mejor_jugador"
                            class="player-id"
                            required>

                        <div class="resultados">
                            {{#each players}}
                                <div class="jugador" data-id="{{id}}">
                                    {{name}} ({{short_name}})
                                </div>
                            {{/each}}
                        </div>
                    </div>


                    <div class="player-selector">
                        <input type="text"
                            class="buscar-jugador"
                            placeholder="Buscar mejor portero..."
                            autocomplete="off">

                        <input type="hidden"
                            name="mejor_portero"
                            class="player-id"
                            required>

                        <div class="resultados">
                            {{#each porteros}}
                                <div class="jugador" data-id="{{id}}">
                                    {{name}} ({{short_name}})
                                </div>
                            {{/each}}
                        </div>
                    </div>

                    <input style="margin-top: 30px;" id="send-jugadores" type="submit" value="Enviar">
                </form>
            {{/if}}
        </div>

        

        </div>
        <script>
            document.addEventListener('DOMContentLoaded', function () {

            const form = document.getElementById('seleccionar_jugadores');

            if (!form) {
                console.warn("Formulario no encontrado.");
                return;
            }

            /* =========================
                VALIDACIÓN DEL FORMULARIO
            ========================== */
            form.addEventListener('submit', function(event) {

                const campos = [
                'maximo_goleador',
                'maximo_asistidor',
                'mejor_jugador',
                'mejor_portero'
                ];

                let formValido = true;

                campos.forEach(nombre => {

                const inputHidden = document.querySelector(`input[name="${nombre}"]`);
                const wrapper = inputHidden?.closest('.player-selector');

                if (!inputHidden || !inputHidden.value) {
                    formValido = false;

                    if (wrapper) {
                    wrapper.style.border = "2px solid red";
                    }

                } else {
                    if (wrapper) {
                    wrapper.style.border = "2px solid green";
                    }
                }

                });

                if (!formValido) {
                event.preventDefault();
                alert("Por favor, selecciona una opción válida en todos los campos.");
                }
            });


            /* =========================
                AUTOCOMPLETE PERSONALIZADO
            ========================== */
            document.querySelectorAll('.player-selector').forEach(selector => {

                const input = selector.querySelector('.buscar-jugador');
                const hidden = selector.querySelector('.player-id');
                const resultados = selector.querySelector('.resultados');
                const jugadores = resultados.querySelectorAll('.jugador');

                // Mostrar lista al enfocar
                input.addEventListener('focus', () => {
                resultados.style.display = 'block';
                });

                input.addEventListener('blur', () => {
                setTimeout(() => {
                    resultados.style.display = 'none';
                }, 150);
                });

                // Filtrar jugadores
                input.addEventListener('input', () => {
                const texto = input.value.toLowerCase();

                resultados.style.display = 'block';

                jugadores.forEach(jugador => {
                    jugador.style.display =
                    jugador.textContent.toLowerCase().includes(texto)
                        ? 'block'
                        : 'none';
                });
                });

                // Selección de jugador
                jugadores.forEach(jugador => {
                jugador.addEventListener('click', () => {

                    input.value = jugador.textContent.trim();
                    hidden.value = jugador.dataset.id;

                    resultados.style.display = 'none';

                    // limpiar errores visuales al seleccionar
                    selector.style.border = "2px solid green";
                });
                });

            });

            });
            </script>

    </body>
</html>